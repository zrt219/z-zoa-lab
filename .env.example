# Z-ZOA local environment template.
# Copy to .env and fill in.  .env is gitignored and must NEVER be committed.

# DeepSeek API (https://api.deepseek.com).  Used by research/llm/deepseek.py
# for optional narrative enrichment of audit reports.  Without it, every
# pipeline stage still runs: the client degrades to its deterministic
# offline path and scripts exit 0.
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
